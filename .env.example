# Copy to .env and adjust. Never commit real secrets.

# --- Application ---------------------------------------------------------
APP_NAME=WorkSync AI
ENVIRONMENT=development
DEBUG=false

# --- Database ------------------------------------------------------------
# Leave unset to use the default local SQLite file (backend/worksync.db).
# PostgreSQL (Docker or local server):
# DATABASE_URL=postgresql+psycopg://worksync:worksync@localhost:5432/worksync

DB_ECHO=false

# --- Security ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480

# JSON array. Must include the frontend origin.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# --- Workforce policy defaults ------------------------------------------
STANDARD_WEEKLY_HOURS=40
STANDARD_DAILY_HOURS=8
DEFAULT_OVERTIME_CAP_WEEKLY=10
DEFAULT_MIN_REST_HOURS=11

# --- Scheduling ---------------------------------------------------------
SCHEDULER_TIME_LIMIT_SECONDS=12
SCHEDULER_MAX_HORIZON_DAYS=31

# --- Data ---------------------------------------------------------------
SEED=20261022
# Load the full CSV seed automatically when the database is empty on startup.
AUTO_SEED_DEMO_DATA=true
